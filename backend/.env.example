# Finovo AI Car Rental - Enterprise Backend Configuration Template
# Copy this file to .env and adjust values for your environment

NODE_ENV=
PORT=

# Database Connection (MySQL 8 / XAMPP)
DATABASE_URL=

# Security & JWT Tokens
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=

# Session & Cookies
SESSION_COOKIE_NAME= 
REFRESH_COOKIE_NAME= 
COOKIE_DOMAIN= 
COOKIE_SECURE= 
COOKIE_SAME_SITE= 

# CORS & Frontend Origins
CORS_ORIGIN= 
FRONTEND_URL= 

# Argon2id Configuration (OWASP Recommended)
ARGON2_MEMORY_COST= 
ARGON2_TIME_COST= 
ARGON2_PARALLELISM= 

# Rate Limiting
RATE_LIMIT_WINDOW_MS= 
RATE_LIMIT_MAX_AUTH= 
RATE_LIMIT_MAX_API= 

# Email Delivery (Mock logger in dev, can configure SMTP)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Finovo AI Car Rental <noreply@finovo-rental.com>"
