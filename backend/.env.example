# Finovo AI Car Rental - backend configuration
# Copy to .env and fill in. In production (NODE_ENV=production) the server refuses to start
# when a required value is missing or insecure, and prints a warning for optional ones.

NODE_ENV=development
PORT=5000

# MySQL 8
DATABASE_URL=mysql://root:@localhost:3306/finovo_car_rental

# JWT: two DIFFERENT random secrets of 32+ characters in production
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d

# Cookies. Leave COOKIE_DOMAIN empty unless the API and site share a parent domain (e.g. .finovo.com)
SESSION_COOKIE_NAME=finovo_session
REFRESH_COOKIE_NAME=finovo_refresh_token
COOKIE_DOMAIN=
# true on HTTPS (default true in production)
COOKIE_SECURE=false
# lax when site and API are on the same site; none (with COOKIE_SECURE=true) when they are on different domains
COOKIE_SAME_SITE=lax

# Frontend URL(s) allowed to call the API, comma-separated. The first one is used in email links.
CORS_ORIGIN=http://localhost:5176

# Number of reverse proxies in front of the API (Nginx = 1). Default 1 in production, 0 in development.
TRUST_PROXY=

# Password hashing (Argon2id, OWASP recommended)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate limits per IP per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_API=120
RATE_LIMIT_MAX_GLOBAL=1500

# Email: mock = print to console (development only); smtp = real delivery (required for live)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Finovo Car Rental <noreply@your-domain.com>"

# Public company details (footer, contact page, FAQ). Empty values fall back to the first active branch.
# Year the company started; the About page shows "years of excellence" from it (hidden when empty)
COMPANY_FOUNDED_YEAR=
COMPANY_NAME="Finovo Car Rental"
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
SUPPORT_HOURS=
COMPANY_ADDRESS=
# Mobile app store links; the app download section and footer column only appear when at least one is set
APP_STORE_URL=
PLAY_STORE_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_X_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_YOUTUBE_URL=

# Optional: Google Cloud Translation v2 API key for translating user-entered text
GOOGLE_TRANSLATION_API_KEY=

# Stripe (sandbox keys: sk_test_..., pk_test_...; live keys only on the live server)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI vehicle inspection (required for pickup / return damage scans)
# Key: https://aistudio.google.com/apikey . Without a key, inspections are refused (no fake results).
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash
# Optional alternative provider, used only when GEMINI_API_KEY is empty
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
# Independent AI passes per scan (2 = consensus: new damage must be seen twice). 1-3
VISION_CONSENSUS_PASSES=2
# Repair cost table is in PKR; scale it for other currencies or premium fleets (e.g. 1.5)
DAMAGE_COST_MULTIPLIER=1
