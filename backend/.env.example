# Finovo AI Car Rental - Enterprise Backend Configuration Template
# Copy this file to .env and adjust values for your environment

NODE_ENV=development
PORT=5000

# Database Connection (MySQL 8 / XAMPP)
DATABASE_URL="mysql://root:@localhost:3306/finovo_car_rental"

# Security & JWT Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_key_2026_ai_car_rental
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_key_2026_ai_car_rental
JWT_REFRESH_EXPIRY=7d

# Session & Cookies
SESSION_COOKIE_NAME=finovo_session
REFRESH_COOKIE_NAME=finovo_refresh_token
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS & Frontend Origins
CORS_ORIGIN=http://localhost:5176
FRONTEND_URL=http://localhost:5176

# Argon2id Configuration (OWASP Recommended)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_API=120

# Email Delivery (Mock logger in dev, can configure SMTP)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Finovo AI Car Rental <noreply@finovo-rental.com>"
