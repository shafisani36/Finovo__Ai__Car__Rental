// Finovo Enterprise Car Rental Management Prisma Schema
// Database: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ORGANIZATION, ACCESS & SECURITY
// ==========================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  fullName         String
  passwordHash     String       @db.VarChar(255)
  isEmailVerified  Boolean      @default(false)
  emailVerifiedAt  DateTime?
  status           UserStatus   @default(ACTIVE)
  organizationId   String?      @db.VarChar(64)
  branchId         String?      @db.VarChar(64)
  avatarUrl        String?      @db.VarChar(512)
  phone            String?      @db.VarChar(32)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  userRoles        UserRole[]
  sessions         Session[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs        SecurityAuditLog[]
  inspections      Inspection[]
  customerProfile  Customer?

  @@index([email])
  @@index([status])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique @db.VarChar(64)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(96)
  name        String           @db.VarChar(128)
  description String?          @db.VarChar(255)
  category    String           @db.VarChar(64)
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  sessionToken     String    @unique @db.VarChar(128)
  refreshTokenHash String    @db.VarChar(255)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  revokedReason    String?   @db.VarChar(128)
  expiresAt        DateTime
  lastActiveAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SecurityAuditLog {
  id        String    @id @default(cuid())
  userId    String?
  event     String    @db.VarChar(64)
  ipAddress String?   @db.VarChar(64)
  userAgent String?   @db.VarChar(512)
  metadata  String?   @db.Text
  createdAt DateTime  @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("security_audit_logs")
}

// ==========================================
// 2. BRANCH & ORGANIZATIONAL INFRASTRUCTURE
// ==========================================

model Branch {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(128)
  code           String    @unique @db.VarChar(32)
  address        String?   @db.VarChar(255)
  city           String    @db.VarChar(64)
  phone          String?   @db.VarChar(32)
  email          String?   @db.VarChar(128)
  openingHours   String?   @db.VarChar(128)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicles       Vehicle[]
  pickupBookings Booking[] @relation("PickupBranch")
  returnBookings Booking[] @relation("ReturnBranch")

  @@index([code])
  @@index([city])
  @@map("branches")
}

// ==========================================
// 3. FLEET & VEHICLE MANAGEMENT
// ==========================================

model VehicleBrand {
  id          String         @id @default(cuid())
  name        String         @unique @db.VarChar(64)
  slug        String         @unique @db.VarChar(64)
  logoUrl     String?        @db.VarChar(512)
  country     String?        @db.VarChar(64)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  models      VehicleModel[]

  @@map("vehicle_brands")
}

model VehicleModel {
  id                String        @id @default(cuid())
  brandId           String
  brand             VehicleBrand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name              String        @db.VarChar(64)
  slug              String        @db.VarChar(64)
  bodyType          String?       @db.VarChar(32)
  defaultCategoryId String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([brandId, name])
  @@index([brandId])
  @@map("vehicle_models")
}

model VehicleCategory {
  id          String    @id @default(cuid())
  name        String    @unique @db.VarChar(64)
  slug        String    @unique @db.VarChar(64)
  description String?   @db.VarChar(255)
  baseRate    Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  vehicles    Vehicle[]

  @@map("vehicle_categories")
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RESERVED
  ARCHIVED
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum PricingMethod {
  daily
  per_km
  daily_extra_km
  hourly
  monthly
}

model Vehicle {
  id                    String           @id @default(cuid())
  brand                 String           @db.VarChar(64)
  model                 String           @db.VarChar(64)
  year                  Int
  trim                  String?          @db.VarChar(64)
  registrationNumber    String           @unique @db.VarChar(32)
  vin                   String?          @unique @db.VarChar(64)
  categoryId            String
  category              VehicleCategory  @relation(fields: [categoryId], references: [id])
  branchId              String?
  branch                Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  transmission          TransmissionType @default(AUTOMATIC)
  fuelType              FuelType         @default(PETROL)
  engineSize            String?          @db.VarChar(64)
  horsePower            Int?
  drivetrain            String?          @db.VarChar(16)
  fuelTankCapacity      String?          @db.VarChar(32)
  fuelLevelPercent      Int?             @default(100)
  seats                 Int              @default(5)
  doors                 Int              @default(4)
  color                 String?          @db.VarChar(32)
  colorHex              String?          @db.VarChar(16)
  mileage               Int              @default(0)
  dailyRate             Decimal          @db.Decimal(10, 2)
  weeklyRate            Decimal?         @db.Decimal(10, 2)
  monthlyRate           Decimal?         @db.Decimal(10, 2)
  securityDeposit       Decimal?         @db.Decimal(10, 2)
  excessMileageFee      Decimal?         @db.Decimal(10, 2)
  mileageLimitPerDay    Int?             @default(250)
  pricingMethod         PricingMethod    @default(daily)
  perKmRate             Decimal?         @db.Decimal(10, 2)
  hourlyRate            Decimal?         @db.Decimal(10, 2)
  minimumTripCharge     Decimal?         @db.Decimal(10, 2)
  minimumBillableHours  Int?             @default(1)
  billingIncrementMinutes Int?           @default(60)
  gracePeriodMinutes    Int?             @default(0)
  partialMonthPolicy    String?          @default("prorated_daily") @db.VarChar(32)
  currency              String           @default("PKR") @db.VarChar(8)
  status                VehicleStatus    @default(AVAILABLE)
  isPublicCatalog       Boolean          @default(true)
  vehicleCode           String?          @db.VarChar(64)
  ownershipType         String?          @default("OWNED") @db.VarChar(32)
  acquisitionDate       DateTime?
  acquisitionCost       Decimal?         @db.Decimal(10, 2)
  isListed              Boolean          @default(true)
  isBookable            Boolean          @default(true)
  deletedAt             DateTime?
  features              String?          @db.Text
  notes                 String?          @db.Text
  parkingSpot           String?          @db.VarChar(64)
  telematicsDeviceId    String?          @db.VarChar(64)
  insurancePolicyNumber String?          @db.VarChar(128)
  insuranceExpiry       DateTime?
  registrationExpiry    DateTime?
  lastServiceDate       DateTime?
  lastServiceMileage    Int?
  nextServiceMileage    Int?
  primaryImageUrl       String?          @db.VarChar(512)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  photos                VehiclePhoto[]
  bookings              Booking[]
  rentals               Rental[]
  inspections           Inspection[]
  documents             VehicleDocument[]
  maintenanceRecords    VehicleMaintenance[]
  damageReports         VehicleDamageReport[]
  odometerLogs          VehicleOdometerLog[]
  locationLogs          VehicleLocationLog[]
  pricingTiers          VehiclePricingTier[]
  auditLogs             VehicleAuditLog[]

  @@index([brand, model])
  @@index([status])
  @@index([categoryId])
  @@index([branchId])
  @@index([registrationNumber])
  @@index([deletedAt])
  @@map("vehicles")
}

model VehiclePhoto {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url        String   @db.VarChar(512)
  caption    String?  @db.VarChar(128)
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([vehicleId])
  @@map("vehicle_photos")
}

enum DocumentType {
  INSURANCE
  REGISTRATION
  ROAD_TAX
  SAFETY_INSPECTION
  COMMERCIAL_PERMIT
  CUSTOMS_DECLARATION
  OTHER
}

model VehicleDocument {
  id                 String         @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType       DocumentType   @default(OTHER)
  title              String         @db.VarChar(128)
  documentNumber     String?        @db.VarChar(128)
  issuedAt           DateTime?
  expiresAt          DateTime?
  fileUrl            String         @db.VarChar(512)
  fileName           String?        @db.VarChar(255)
  fileSize           Int?
  verificationStatus String         @default("VERIFIED") @db.VarChar(32)
  verifiedBy         String?        @db.VarChar(128)
  verifiedAt         DateTime?
  notes              String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([vehicleId])
  @@index([documentType])
  @@index([expiresAt])
  @@map("vehicle_documents")
}

enum MaintenanceType {
  SCHEDULED_SERVICE
  OIL_CHANGE
  BRAKE_SERVICE
  TIRE_ROTATION_REPLACEMENT
  ENGINE_TUNEUP
  BATTERY_CHECK
  HVAC_SERVICE
  REPAIR
  BODY_WORK
  RECALL_ACTION
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model VehicleMaintenance {
  id                   String            @id @default(cuid())
  vehicleId            String
  vehicle              Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceType      MaintenanceType   @default(SCHEDULED_SERVICE)
  status               MaintenanceStatus @default(SCHEDULED)
  title                String            @db.VarChar(128)
  description          String?           @db.Text
  serviceProvider      String?           @db.VarChar(128)
  scheduledDate        DateTime
  startDate            DateTime?
  completedDate        DateTime?
  odometerReading      Int?
  cost                 Decimal?          @db.Decimal(10, 2)
  currency             String            @default("USD") @db.VarChar(8)
  invoiceNumber        String?           @db.VarChar(64)
  nextServiceDueMileage Int?
  nextServiceDueDate   DateTime?
  notes                String?           @db.Text
  createdBy            String?           @db.VarChar(128)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
  @@map("vehicle_maintenance")
}

enum DamageSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DamageStatus {
  REPORTED
  ASSESSED
  REPAIR_SCHEDULED
  RESOLVED
}

model VehicleDamageReport {
  id                  String         @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookingId           String?
  reportedBy          String?        @db.VarChar(128)
  reportedDate        DateTime       @default(now())
  damageType          String         @db.VarChar(64)
  severity            DamageSeverity @default(LOW)
  status              DamageStatus   @default(REPORTED)
  locationOnVehicle   String?        @db.VarChar(64)
  description         String         @db.Text
  estimatedRepairCost Decimal?       @db.Decimal(10, 2)
  actualRepairCost    Decimal?       @db.Decimal(10, 2)
  currency            String         @default("USD") @db.VarChar(8)
  photoUrls           String?        @db.Text
  resolvedAt          DateTime?
  notes               String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([severity])
  @@map("vehicle_damage_reports")
}

model VehicleOdometerLog {
  id              String   @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookingId       String?
  odometerReading Int
  source          String   @default("MANUAL") @db.VarChar(32)
  recordedBy      String?  @db.VarChar(128)
  recordedAt      DateTime @default(now())
  notes           String?  @db.Text

  @@index([vehicleId])
  @@index([recordedAt])
  @@map("vehicle_odometer_logs")
}

model VehicleLocationLog {
  id             String    @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  branchId       String?
  parkingBay     String?   @db.VarChar(64)
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  locationSource String    @default("BRANCH_ASSIGNMENT") @db.VarChar(64)
  recordedAt     DateTime  @default(now())
  notes          String?   @db.Text

  @@index([vehicleId])
  @@index([recordedAt])
  @@map("vehicle_locations")
}

model VehiclePricingTier {
  id                  String         @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rateName            String         @db.VarChar(64)
  billingUnit         String         @default("DAY") @db.VarChar(16)
  pricingMethod       PricingMethod  @default(daily)
  baseRate            Decimal        @db.Decimal(10, 2)
  currency            String         @default("PKR") @db.VarChar(8)
  hourlyRate          Decimal?       @db.Decimal(10, 2)
  perKmRate           Decimal?       @db.Decimal(10, 2)
  monthlyRate         Decimal?       @db.Decimal(10, 2)
  minimumTripCharge   Decimal?       @db.Decimal(10, 2)
  minimumBillableHours Int?          @default(1)
  billingIncrementMinutes Int?       @default(60)
  gracePeriodMinutes  Int?           @default(0)
  partialMonthPolicy  String?        @default("prorated_daily") @db.VarChar(32)
  depositPolicy       String?        @db.VarChar(64)
  securityDeposit     Decimal?       @db.Decimal(10, 2)
  includedKmPerDay    Int?           @default(250)
  extraKmRate         Decimal?       @db.Decimal(10, 2)
  minimumDurationDays Int?           @default(1)
  maximumDurationDays Int?
  validFrom           DateTime?
  validUntil          DateTime?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([vehicleId])
  @@index([isActive])
  @@map("vehicle_pricing")
}

model VehicleAuditLog {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId     String?  @db.VarChar(64)
  userEmail  String?  @db.VarChar(128)
  action     String   @db.VarChar(64)
  details    String?  @db.Text
  changes    String?  @db.Text
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([vehicleId])
  @@index([action])
  @@index([createdAt])
  @@map("vehicle_audit_logs")
}

// ==========================================
// 4. CUSTOMERS, BOOKINGS & RENTALS
// ==========================================

model Customer {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName            String    @db.VarChar(128)
  email               String    @unique @db.VarChar(128)
  phone               String?   @db.VarChar(32)
  driverLicenseNumber String?   @db.VarChar(64)
  licenseExpiryDate   DateTime?
  isLicenseVerified   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bookings            Booking[]

  @@index([email])
  @@index([fullName])
  @@map("customers")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

model Booking {
  id             String                    @id @default(cuid())
  bookingNumber  String                    @unique @db.VarChar(64)
  customerId     String
  customer       Customer                  @relation(fields: [customerId], references: [id])
  vehicleId      String
  vehicle        Vehicle                   @relation(fields: [vehicleId], references: [id])
  pickupBranchId String
  pickupBranch   Branch                    @relation("PickupBranch", fields: [pickupBranchId], references: [id])
  returnBranchId String
  returnBranch   Branch                    @relation("ReturnBranch", fields: [returnBranchId], references: [id])
  pickupDateTime DateTime
  returnDateTime DateTime
  status         BookingStatus             @default(PENDING)
  pricingMethod  PricingMethod             @default(daily)
  dailyRate      Decimal                   @db.Decimal(10, 2)
  totalDays      Int
  subtotal       Decimal                   @db.Decimal(10, 2)
  taxAmount      Decimal                   @default(0) @db.Decimal(10, 2)
  depositAmount  Decimal                   @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal                   @db.Decimal(10, 2)
  finalTotal     Decimal?                  @db.Decimal(10, 2)
  settlementStatus String?                 @default("PENDING") @db.VarChar(32)
  currency       String                    @default("PKR") @db.VarChar(8)
  notes          String?                   @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  rental         Rental?
  pricingSnapshot BookingPricingSnapshot?
  breakdownItems BookingPricingBreakdown[]

  @@index([bookingNumber])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([pickupDateTime, returnDateTime])
  @@map("bookings")
}

model BookingPricingSnapshot {
  id                      String        @id @default(cuid())
  bookingId               String        @unique
  booking                 Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pricingMethod           PricingMethod
  currency                String        @default("PKR") @db.VarChar(8)

  // Rate snapshot
  dailyRate               Decimal?      @db.Decimal(10, 2)
  perKmRate               Decimal?      @db.Decimal(10, 2)
  hourlyRate              Decimal?      @db.Decimal(10, 2)
  monthlyRate             Decimal?      @db.Decimal(10, 2)
  excessMileageRate       Decimal?      @db.Decimal(10, 2)
  minimumTripCharge       Decimal?      @db.Decimal(10, 2)

  // Policy snapshot
  includedKmPerDay        Int?
  includedKmPerBooking    Int?
  minimumBillableHours    Int?
  billingIncrementMinutes Int?
  gracePeriodMinutes      Int?
  partialMonthPolicy      String?       @db.VarChar(32)
  depositAmount           Decimal?      @db.Decimal(10, 2)
  taxRatePercent          Decimal?      @db.Decimal(5, 2)

  // Immutability & Audit
  pricingEngineVersion    String        @default("v1.0.0") @db.VarChar(32)
  rawConfigSnapshot       String?       @db.Text
  quotedAt                DateTime      @default(now())
  acceptedAt              DateTime?
  createdAt               DateTime      @default(now())

  @@index([bookingId])
  @@map("booking_pricing_snapshots")
}

model BookingPricingBreakdown {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lineType     String   @db.VarChar(48)
  description  String   @db.VarChar(255)
  quantity     Decimal  @default(1.00) @db.Decimal(10, 2)
  unit         String   @default("UNIT") @db.VarChar(32)
  unitPrice    Decimal  @db.Decimal(10, 2)
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("PKR") @db.VarChar(8)
  isTaxable    Boolean  @default(false)
  taxAmount    Decimal  @default(0.00) @db.Decimal(10, 2)
  metadata     String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([bookingId])
  @@index([lineType])
  @@map("booking_pricing_breakdowns")
}

model Rental {
  id                     String       @id @default(cuid())
  bookingId              String       @unique
  booking                Booking      @relation(fields: [bookingId], references: [id])
  vehicleId              String
  vehicle                Vehicle      @relation(fields: [vehicleId], references: [id])
  startMileage           Int
  endMileage             Int?
  startFuelLevel         String       @default("100%") @db.VarChar(16)
  endFuelLevel           String?      @db.VarChar(16)
  verifiedBillableKm     Int?
  extraKm                Int?         @default(0)
  extraKmCharge          Decimal?     @default(0.00) @db.Decimal(10, 2)
  lateReturnHours        Decimal?     @default(0.00) @db.Decimal(10, 2)
  lateReturnFee          Decimal?     @default(0.00) @db.Decimal(10, 2)
  damageCharges          Decimal?     @default(0.00) @db.Decimal(10, 2)
  fuelCharges            Decimal?     @default(0.00) @db.Decimal(10, 2)
  depositRefundAmount    Decimal?     @default(0.00) @db.Decimal(10, 2)
  depositDeductionAmount Decimal?     @default(0.00) @db.Decimal(10, 2)
  netPayableOrRefund     Decimal?     @default(0.00) @db.Decimal(10, 2)
  settlementNotes        String?      @db.Text
  settledAt              DateTime?
  settledBy              String?      @db.VarChar(128)
  pickedUpAt             DateTime     @default(now())
  returnedAt             DateTime?
  status                 String       @default("ACTIVE") @db.VarChar(32)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  inspections            Inspection[]

  @@index([vehicleId])
  @@map("rentals")
}

// ==========================================
// 5. AI INSPECTION & DAMAGE FINDINGS
// ==========================================

enum InspectionType {
  PICKUP
  RETURN
  ROUTINE
}

model Inspection {
  id                 String           @id @default(cuid())
  rentalId           String?
  rental             Rental?          @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  vehicleId          String
  vehicle            Vehicle          @relation(fields: [vehicleId], references: [id])
  type               InspectionType
  performedById      String?
  performedBy        User?            @relation(fields: [performedById], references: [id], onDelete: SetNull)
  overallScore       Float?
  summary            String?          @db.Text
  hasDamageDetected  Boolean          @default(false)
  createdAt          DateTime         @default(now())

  photos             InspectionPhoto[]
  findings           DamageFinding[]

  @@index([vehicleId])
  @@index([rentalId])
  @@index([type])
  @@map("inspections")
}

model InspectionPhoto {
  id           String      @id @default(cuid())
  inspectionId String
  inspection   Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  view         String      @db.VarChar(32)
  imageUrl     String      @db.VarChar(512)
  processedUrl String?     @db.VarChar(512)
  qualityScore Float?
  createdAt    DateTime    @default(now())

  @@index([inspectionId])
  @@map("inspection_photos")
}

model DamageFinding {
  id                  String      @id @default(cuid())
  inspectionId        String
  inspection          Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  damageType          String      @db.VarChar(64)
  severity            String      @db.VarChar(32)
  location            String      @db.VarChar(64)
  confidence          Float
  boundingBox         String?     @db.Text
  estimatedRepairCost Decimal?    @db.Decimal(10, 2)
  isHumanVerified     Boolean     @default(false)
  humanDecision       String?     @db.VarChar(64)
  createdAt           DateTime    @default(now())

  @@index([inspectionId])
  @@map("damage_findings")
}
