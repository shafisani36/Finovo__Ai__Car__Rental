generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  fullName            String
  passwordHash        String               @db.VarChar(255)
  isEmailVerified     Boolean              @default(false)
  emailVerifiedAt     DateTime?
  status              UserStatus           @default(ACTIVE)
  organizationId      String?              @db.VarChar(64)
  branchId            String?              @db.VarChar(64)
  avatarUrl           String?              @db.VarChar(512)
  phone               String?              @db.VarChar(32)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  preferredLanguage   String?              @default("en") @db.VarChar(10)
  customerProfile     Customer?
  inspections         Inspection[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           SecurityAuditLog[]
  sessions            Session[]
  userRoles           UserRole[]
  verificationTokens  VerificationToken[]

  @@index([email])
  @@index([status])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique @db.VarChar(64)
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique @db.VarChar(96)
  name            String           @db.VarChar(128)
  description     String?          @db.VarChar(255)
  category        String           @db.VarChar(64)
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  sessionToken     String    @unique @db.VarChar(128)
  refreshTokenHash String    @db.VarChar(255)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  revokedReason    String?   @db.VarChar(128)
  expiresAt        DateTime
  lastActiveAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String   @db.VarChar(64)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  metadata  String?  @db.Text
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("security_audit_logs")
}

model Branch {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(128)
  code           String    @unique @db.VarChar(32)
  address        String?   @db.VarChar(255)
  city           String    @db.VarChar(64)
  phone          String?   @db.VarChar(32)
  email          String?   @db.VarChar(128)
  openingHours   String?   @db.VarChar(128)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  pickupBookings Booking[] @relation("PickupBranch")
  returnBookings Booking[] @relation("ReturnBranch")
  vehicles       Vehicle[]

  @@index([code])
  @@index([city])
  @@map("branches")
}

model VehicleBrand {
  id        String         @id @default(cuid())
  name      String         @unique @db.VarChar(64)
  slug      String         @unique @db.VarChar(64)
  logoUrl   String?        @db.VarChar(512)
  country   String?        @db.VarChar(64)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  models    VehicleModel[]

  @@map("vehicle_brands")
}

model VehicleModel {
  id                String       @id @default(cuid())
  brandId           String
  name              String       @db.VarChar(64)
  slug              String       @db.VarChar(64)
  bodyType          String?      @db.VarChar(32)
  defaultCategoryId String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  brand             VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
  @@index([brandId])
  @@map("vehicle_models")
}

model VehicleCategory {
  id          String    @id @default(cuid())
  name        String    @unique @db.VarChar(64)
  slug        String    @unique @db.VarChar(64)
  description String?   @db.VarChar(255)
  baseRate    Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  vehicles    Vehicle[]

  @@map("vehicle_categories")
}

model Vehicle {
  id                      String                @id @default(cuid())
  brand                   String                @db.VarChar(64)
  model                   String                @db.VarChar(64)
  year                    Int
  registrationNumber      String                @unique @db.VarChar(32)
  vin                     String?               @unique @db.VarChar(64)
  categoryId              String
  branchId                String?
  transmission            TransmissionType      @default(AUTOMATIC)
  fuelType                FuelType              @default(PETROL)
  seats                   Int                   @default(5)
  doors                   Int                   @default(4)
  color                   String?               @db.VarChar(32)
  mileage                 Int                   @default(0)
  dailyRate               Decimal               @db.Decimal(10, 2)
  weeklyRate              Decimal?              @db.Decimal(10, 2)
  monthlyRate             Decimal?              @db.Decimal(10, 2)
  status                  VehicleStatus         @default(AVAILABLE)
  isPublicCatalog         Boolean               @default(true)
  notes                   String?               @db.Text
  primaryImageUrl         String?               @db.VarChar(512)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  colorHex                String?               @db.VarChar(16)
  drivetrain              String?               @db.VarChar(16)
  engineSize              String?               @db.VarChar(64)
  excessMileageFee        Decimal?              @db.Decimal(10, 2)
  features                String?               @db.Text
  fuelLevelPercent        Int?                  @default(100)
  fuelTankCapacity        String?               @db.VarChar(32)
  horsePower              Int?
  insuranceExpiry         DateTime?
  insurancePolicyNumber   String?               @db.VarChar(128)
  lastServiceDate         DateTime?
  lastServiceMileage      Int?
  mileageLimitPerDay      Int?                  @default(250)
  nextServiceMileage      Int?
  parkingSpot             String?               @db.VarChar(64)
  registrationExpiry      DateTime?
  securityDeposit         Decimal?              @db.Decimal(10, 2)
  telematicsDeviceId      String?               @db.VarChar(64)
  trim                    String?               @db.VarChar(64)
  acquisitionCost         Decimal?              @db.Decimal(10, 2)
  acquisitionDate         DateTime?
  deletedAt               DateTime?
  isBookable              Boolean               @default(true)
  isListed                Boolean               @default(true)
  ownershipType           String?               @default("OWNED") @db.VarChar(32)
  vehicleCode             String?               @db.VarChar(64)
  billingIncrementMinutes Int?                  @default(60)
  currency                String                @default("PKR") @db.VarChar(8)
  gracePeriodMinutes      Int?                  @default(0)
  hourlyRate              Decimal?              @db.Decimal(10, 2)
  minimumBillableHours    Int?                  @default(1)
  minimumTripCharge       Decimal?              @db.Decimal(10, 2)
  partialMonthPolicy      String?               @default("prorated_daily") @db.VarChar(32)
  perKmRate               Decimal?              @db.Decimal(10, 2)
  pricingMethod           PricingMethod         @default(daily)
  bookings                Booking[]
  damage_comparisons      damage_comparisons[]
  inspections             Inspection[]
  rentals                 Rental[]
  auditLogs               VehicleAuditLog[]
  damageReports           VehicleDamageReport[]
  documents               VehicleDocument[]
  locationLogs            VehicleLocationLog[]
  maintenanceRecords      VehicleMaintenance[]
  odometerLogs            VehicleOdometerLog[]
  photos                  VehiclePhoto[]
  pricingTiers            VehiclePricingTier[]
  reviews                 VehicleReview[]
  branch                  Branch?               @relation(fields: [branchId], references: [id])
  category                VehicleCategory       @relation(fields: [categoryId], references: [id])

  @@index([brand, model])
  @@index([status])
  @@index([categoryId])
  @@index([branchId])
  @@index([registrationNumber])
  @@index([deletedAt])
  @@map("vehicles")
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  url       String   @db.VarChar(512)
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  caption   String?  @db.VarChar(128)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_photos")
}

model VehicleDocument {
  id                 String       @id @default(cuid())
  vehicleId          String
  documentType       DocumentType @default(OTHER)
  title              String       @db.VarChar(128)
  documentNumber     String?      @db.VarChar(128)
  issuedAt           DateTime?
  expiresAt          DateTime?
  fileUrl            String       @db.VarChar(512)
  fileName           String?      @db.VarChar(255)
  fileSize           Int?
  verificationStatus String       @default("VERIFIED") @db.VarChar(32)
  verifiedBy         String?      @db.VarChar(128)
  verifiedAt         DateTime?
  notes              String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  vehicle            Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([documentType])
  @@index([expiresAt])
  @@map("vehicle_documents")
}

model VehicleMaintenance {
  id                    String            @id @default(cuid())
  vehicleId             String
  maintenanceType       MaintenanceType   @default(SCHEDULED_SERVICE)
  status                MaintenanceStatus @default(SCHEDULED)
  title                 String            @db.VarChar(128)
  description           String?           @db.Text
  serviceProvider       String?           @db.VarChar(128)
  scheduledDate         DateTime
  startDate             DateTime?
  completedDate         DateTime?
  odometerReading       Int?
  cost                  Decimal?          @db.Decimal(10, 2)
  currency              String            @default("USD") @db.VarChar(8)
  invoiceNumber         String?           @db.VarChar(64)
  nextServiceDueMileage Int?
  nextServiceDueDate    DateTime?
  notes                 String?           @db.Text
  createdBy             String?           @db.VarChar(128)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  vehicle               Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
  @@map("vehicle_maintenance")
}

model VehicleDamageReport {
  id                  String         @id @default(cuid())
  vehicleId           String
  bookingId           String?
  reportedBy          String?        @db.VarChar(128)
  reportedDate        DateTime       @default(now())
  damageType          String         @db.VarChar(64)
  severity            DamageSeverity @default(LOW)
  status              DamageStatus   @default(REPORTED)
  locationOnVehicle   String?        @db.VarChar(64)
  description         String         @db.Text
  estimatedRepairCost Decimal?       @db.Decimal(10, 2)
  actualRepairCost    Decimal?       @db.Decimal(10, 2)
  currency            String         @default("USD") @db.VarChar(8)
  photoUrls           String?        @db.Text
  resolvedAt          DateTime?
  notes               String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  vehicle             Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status])
  @@index([severity])
  @@map("vehicle_damage_reports")
}

model VehicleOdometerLog {
  id              String   @id @default(cuid())
  vehicleId       String
  bookingId       String?
  odometerReading Int
  source          String   @default("MANUAL") @db.VarChar(32)
  recordedBy      String?  @db.VarChar(128)
  recordedAt      DateTime @default(now())
  notes           String?  @db.Text
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([recordedAt])
  @@map("vehicle_odometer_logs")
}

model VehicleLocationLog {
  id             String   @id @default(cuid())
  vehicleId      String
  branchId       String?
  parkingBay     String?  @db.VarChar(64)
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  locationSource String   @default("BRANCH_ASSIGNMENT") @db.VarChar(64)
  recordedAt     DateTime @default(now())
  notes          String?  @db.Text
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([recordedAt])
  @@map("vehicle_locations")
}

model VehiclePricingTier {
  id                      String        @id @default(cuid())
  vehicleId               String
  rateName                String        @db.VarChar(64)
  billingUnit             String        @default("DAY") @db.VarChar(16)
  baseRate                Decimal       @db.Decimal(10, 2)
  currency                String        @default("PKR") @db.VarChar(8)
  securityDeposit         Decimal?      @db.Decimal(10, 2)
  includedKmPerDay        Int?          @default(250)
  extraKmRate             Decimal?      @db.Decimal(10, 2)
  minimumDurationDays     Int?          @default(1)
  maximumDurationDays     Int?
  validFrom               DateTime?
  validUntil              DateTime?
  isActive                Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  billingIncrementMinutes Int?          @default(60)
  depositPolicy           String?       @db.VarChar(64)
  gracePeriodMinutes      Int?          @default(0)
  hourlyRate              Decimal?      @db.Decimal(10, 2)
  minimumBillableHours    Int?          @default(1)
  minimumTripCharge       Decimal?      @db.Decimal(10, 2)
  monthlyRate             Decimal?      @db.Decimal(10, 2)
  partialMonthPolicy      String?       @default("prorated_daily") @db.VarChar(32)
  perKmRate               Decimal?      @db.Decimal(10, 2)
  pricingMethod           PricingMethod @default(daily)
  vehicle                 Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([isActive])
  @@map("vehicle_pricing")
}

model VehicleAuditLog {
  id        String   @id @default(cuid())
  vehicleId String
  userId    String?  @db.VarChar(64)
  userEmail String?  @db.VarChar(128)
  action    String   @db.VarChar(64)
  details   String?  @db.Text
  changes   String?  @db.Text
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([action])
  @@index([createdAt])
  @@map("vehicle_audit_logs")
}

model Customer {
  id                  String                 @id @default(cuid())
  userId              String?                @unique
  fullName            String                 @db.VarChar(128)
  email               String                 @unique @db.VarChar(128)
  phone               String?                @db.VarChar(32)
  driverLicenseNumber String?                @db.VarChar(64)
  licenseExpiryDate   DateTime?
  isLicenseVerified   Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  bookings            Booking[]
  user                User?                  @relation(fields: [userId], references: [id])
  documents           CustomerDocument[]
  notifications       CustomerNotification[]
  supportTickets      SupportTicket[]
  reviews             VehicleReview[]

  @@index([email])
  @@index([fullName])
  @@map("customers")
}

model Booking {
  id                 String                    @id @default(cuid())
  bookingNumber      String                    @unique @db.VarChar(64)
  customerId         String
  vehicleId          String
  pickupBranchId     String
  returnBranchId     String
  pickupDateTime     DateTime
  returnDateTime     DateTime
  status             bookings_status           @default(PENDING)
  dailyRate          Decimal                   @db.Decimal(10, 2)
  totalDays          Int
  subtotal           Decimal                   @db.Decimal(10, 2)
  taxAmount          Decimal                   @default(0.00) @db.Decimal(10, 2)
  depositAmount      Decimal                   @default(0.00) @db.Decimal(10, 2)
  totalAmount        Decimal                   @db.Decimal(10, 2)
  currency           String                    @default("PKR") @db.VarChar(8)
  notes              String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  finalTotal         Decimal?                  @db.Decimal(10, 2)
  pricingMethod      PricingMethod             @default(daily)
  settlementStatus   String?                   @default("PENDING") @db.VarChar(32)
  breakdownItems     BookingPricingBreakdown[]
  pricingSnapshot    BookingPricingSnapshot?
  customer           Customer                  @relation(fields: [customerId], references: [id])
  pickupBranch       Branch                    @relation("PickupBranch", fields: [pickupBranchId], references: [id])
  returnBranch       Branch                    @relation("ReturnBranch", fields: [returnBranchId], references: [id])
  vehicle            Vehicle                   @relation(fields: [vehicleId], references: [id])
  damage_charges     damage_charges[]
  damage_comparisons damage_comparisons[]
  payments           payments[]
  rental             Rental?
  report_documents   report_documents[]

  @@index([bookingNumber])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([pickupDateTime, returnDateTime])
  @@index([pickupBranchId], map: "bookings_pickupBranchId_fkey")
  @@index([returnBranchId], map: "bookings_returnBranchId_fkey")
  @@map("bookings")
}

model BookingPricingSnapshot {
  id                      String        @id @default(cuid())
  bookingId               String        @unique
  pricingMethod           PricingMethod
  currency                String        @default("PKR") @db.VarChar(8)
  dailyRate               Decimal?      @db.Decimal(10, 2)
  perKmRate               Decimal?      @db.Decimal(10, 2)
  hourlyRate              Decimal?      @db.Decimal(10, 2)
  monthlyRate             Decimal?      @db.Decimal(10, 2)
  excessMileageRate       Decimal?      @db.Decimal(10, 2)
  minimumTripCharge       Decimal?      @db.Decimal(10, 2)
  includedKmPerDay        Int?
  includedKmPerBooking    Int?
  minimumBillableHours    Int?
  billingIncrementMinutes Int?
  gracePeriodMinutes      Int?
  partialMonthPolicy      String?       @db.VarChar(32)
  depositAmount           Decimal?      @db.Decimal(10, 2)
  taxRatePercent          Decimal?      @db.Decimal(5, 2)
  pricingEngineVersion    String        @default("v1.0.0") @db.VarChar(32)
  rawConfigSnapshot       String?       @db.Text
  quotedAt                DateTime      @default(now())
  acceptedAt              DateTime?
  createdAt               DateTime      @default(now())
  booking                 Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_pricing_snapshots")
}

model BookingPricingBreakdown {
  id          String   @id @default(cuid())
  bookingId   String
  lineType    String   @db.VarChar(48)
  description String   @db.VarChar(255)
  quantity    Decimal  @default(1.00) @db.Decimal(10, 2)
  unit        String   @default("UNIT") @db.VarChar(32)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("PKR") @db.VarChar(8)
  isTaxable   Boolean  @default(false)
  taxAmount   Decimal  @default(0.00) @db.Decimal(10, 2)
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([lineType])
  @@map("booking_pricing_breakdowns")
}

model Rental {
  id                     String       @id @default(cuid())
  bookingId              String       @unique
  vehicleId              String
  startMileage           Int
  endMileage             Int?
  startFuelLevel         String       @default("100%") @db.VarChar(16)
  endFuelLevel           String?      @db.VarChar(16)
  pickedUpAt             DateTime     @default(now())
  returnedAt             DateTime?
  status                 String       @default("ACTIVE") @db.VarChar(32)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  damageCharges          Decimal?     @default(0.00) @db.Decimal(10, 2)
  depositDeductionAmount Decimal?     @default(0.00) @db.Decimal(10, 2)
  depositRefundAmount    Decimal?     @default(0.00) @db.Decimal(10, 2)
  extraKm                Int?         @default(0)
  extraKmCharge          Decimal?     @default(0.00) @db.Decimal(10, 2)
  fuelCharges            Decimal?     @default(0.00) @db.Decimal(10, 2)
  lateReturnFee          Decimal?     @default(0.00) @db.Decimal(10, 2)
  lateReturnHours        Decimal?     @default(0.00) @db.Decimal(10, 2)
  netPayableOrRefund     Decimal?     @default(0.00) @db.Decimal(10, 2)
  settledAt              DateTime?
  settledBy              String?      @db.VarChar(128)
  settlementNotes        String?      @db.Text
  verifiedBillableKm     Int?
  inspections            Inspection[]
  booking                Booking      @relation(fields: [bookingId], references: [id])
  vehicle                Vehicle      @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("rentals")
}

model Inspection {
  id                                                                    String               @id @default(cuid())
  rentalId                                                              String?
  vehicleId                                                             String
  type                                                                  InspectionType
  performedById                                                         String?
  overallScore                                                          Float?
  summary                                                               String?              @db.Text
  hasDamageDetected                                                     Boolean              @default(false)
  createdAt                                                             DateTime             @default(now())
  capturePlanVersion                                                    String?              @default("v1.0") @db.VarChar(16)
  coverageScore                                                         Float?               @default(100)
  status                                                                inspections_status   @default(FINALIZED)
  updatedAt                                                             DateTime             @default(now())
  damage_comparisons_damage_comparisons_pickupInspectionIdToinspections damage_comparisons[] @relation("damage_comparisons_pickupInspectionIdToinspections")
  damage_comparisons_damage_comparisons_returnInspectionIdToinspections damage_comparisons[] @relation("damage_comparisons_returnInspectionIdToinspections")
  findings                                                              DamageFinding[]
  photos                                                                InspectionPhoto[]
  performedBy                                                           User?                @relation(fields: [performedById], references: [id])
  rental                                                                Rental?              @relation(fields: [rentalId], references: [id])
  vehicle                                                               Vehicle              @relation(fields: [vehicleId], references: [id])
  report_documents                                                      report_documents[]

  @@index([vehicleId])
  @@index([rentalId])
  @@index([type])
  @@index([performedById], map: "inspections_performedById_fkey")
  @@index([status])
  @@map("inspections")
}

model InspectionPhoto {
  id             String     @id @default(cuid())
  inspectionId   String
  view           String     @db.VarChar(32)
  imageUrl       String     @db.VarChar(512)
  processedUrl   String?    @db.VarChar(512)
  qualityScore   Float?
  createdAt      DateTime   @default(now())
  dimensions     String?    @db.VarChar(32)
  fileSizeBytes  Int?
  qualityDetails String?    @db.Text
  sha256Hash     String?    @db.VarChar(64)
  inspection     Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_photos")
}

model DamageFinding {
  id                  String           @id @default(cuid())
  inspectionId        String
  damageType          String           @db.VarChar(64)
  severity            String           @db.VarChar(32)
  location            String           @db.VarChar(64)
  confidence          Float
  boundingBox         String?          @db.Text
  isHumanVerified     Boolean          @default(false)
  humanDecision       String?          @db.VarChar(64)
  createdAt           DateTime         @default(now())
  estimatedRepairCost Decimal?         @db.Decimal(10, 2)
  cropUrl             String?          @db.VarChar(512)
  region              String?          @db.VarChar(64)
  damage_charges      damage_charges[]
  inspection          Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("damage_findings")
}

model Inquiry {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(128)
  email        String        @db.VarChar(128)
  phone        String?       @db.VarChar(32)
  subject      String        @db.VarChar(255)
  message      String        @db.Text
  status       InquiryStatus @default(NEW)
  replyMessage String?       @db.Text
  repliedAt    DateTime?
  repliedBy    String?       @db.VarChar(128)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("inquiries")
}

model TranslationCache {
  id             String   @id @default(cuid())
  sourceHash     String   @db.VarChar(64)
  sourceLang     String   @db.VarChar(10)
  targetLang     String   @db.VarChar(10)
  sourceText     String   @db.MediumText
  translatedText String   @db.MediumText
  provider       String   @default("google") @db.VarChar(32)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceHash, sourceLang, targetLang])
  @@index([sourceHash])
  @@map("translation_cache")
}

model damage_charges {
  id                 String                @id
  bookingId          String
  comparisonId       String?
  damageFindingId    String?
  description        String                @db.VarChar(255)
  proposedAmount     Decimal               @db.Decimal(10, 2)
  approvedAmount     Decimal               @default(0.00) @db.Decimal(10, 2)
  currency           String                @default("PKR") @db.VarChar(8)
  status             damage_charges_status @default(PROPOSED)
  approvedById       String?               @db.VarChar(64)
  approvedAt         DateTime?
  disputeNotes       String?               @db.Text
  disputeOpenedAt    DateTime?
  disputeResolvedAt  DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime
  bookings           Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  damage_comparisons damage_comparisons?   @relation(fields: [comparisonId], references: [id])
  damage_findings    DamageFinding?        @relation(fields: [damageFindingId], references: [id])

  @@index([bookingId])
  @@index([comparisonId])
  @@index([damageFindingId], map: "damage_charges_damageFindingId_fkey")
  @@index([status])
}

model damage_comparison_matches {
  id                 String                                   @id
  comparisonId       String
  findingId          String?                                  @db.VarChar(64)
  baselineFindingId  String?                                  @db.VarChar(64)
  region             String                                   @db.VarChar(64)
  classification     damage_comparison_matches_classification
  confidence         Float
  proposedCost       Decimal?                                 @default(0.00) @db.Decimal(10, 2)
  evidencePair       String?                                  @db.MediumText
  reviewerDecision   String?                                  @db.VarChar(64)
  reviewerNotes      String?                                  @db.Text
  createdAt          DateTime                                 @default(now())
  damage_comparisons damage_comparisons                       @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([classification])
  @@index([comparisonId])
}

model damage_comparisons {
  id                                                             String                      @id
  bookingId                                                      String
  vehicleId                                                      String
  pickupInspectionId                                             String
  returnInspectionId                                             String
  status                                                         damage_comparisons_status   @default(PENDING_REVIEW)
  summary                                                        String?                     @db.Text
  coverageParityScore                                            Float                       @default(100)
  preExistingCount                                               Int                         @default(0)
  newDamageCount                                                 Int                         @default(0)
  inconclusiveCount                                              Int                         @default(0)
  totalProposedCharges                                           Decimal                     @default(0.00) @db.Decimal(10, 2)
  totalApprovedCharges                                           Decimal                     @default(0.00) @db.Decimal(10, 2)
  reviewerId                                                     String?                     @db.VarChar(64)
  reviewedAt                                                     DateTime?
  reviewNotes                                                    String?                     @db.Text
  createdAt                                                      DateTime                    @default(now())
  updatedAt                                                      DateTime
  damage_charges                                                 damage_charges[]
  damage_comparison_matches                                      damage_comparison_matches[]
  bookings                                                       Booking                     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inspections_damage_comparisons_pickupInspectionIdToinspections Inspection                  @relation("damage_comparisons_pickupInspectionIdToinspections", fields: [pickupInspectionId], references: [id], onDelete: Cascade)
  inspections_damage_comparisons_returnInspectionIdToinspections Inspection                  @relation("damage_comparisons_returnInspectionIdToinspections", fields: [returnInspectionId], references: [id], onDelete: Cascade)
  vehicles                                                       Vehicle                     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  report_documents                                               report_documents[]

  @@index([bookingId])
  @@index([pickupInspectionId])
  @@index([returnInspectionId])
  @@index([status])
  @@index([vehicleId])
}

model idempotency_records {
  id             String   @id
  key            String   @unique @db.VarChar(128)
  handler        String   @db.VarChar(64)
  responseStatus Int
  responseBody   String   @db.MediumText
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([expiresAt])
  @@index([key])
}

model payments {
  id              String          @id
  bookingId       String
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("PKR") @db.VarChar(8)
  status          payments_status @default(PENDING)
  provider        String          @default("stripe") @db.VarChar(32)
  paymentIntentId String?         @unique @db.VarChar(128)
  clientSecret    String?         @db.VarChar(255)
  receiptUrl      String?         @db.VarChar(512)
  metadata        String?         @db.Text
  errorMessage    String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  bookings        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds         refunds[]

  @@index([bookingId])
  @@index([paymentIntentId])
  @@index([status])
}

model price_quotes {
  id             String                     @id
  vehicleId      String
  customerId     String?
  pickupDateTime DateTime
  returnDateTime DateTime
  pricingMethod  price_quotes_pricingMethod @default(daily)
  currency       String                     @default("PKR") @db.VarChar(8)
  totalAmount    Decimal                    @db.Decimal(10, 2)
  depositAmount  Decimal                    @default(0.00) @db.Decimal(10, 2)
  quoteSnapshot  String                     @db.MediumText
  signature      String                     @db.VarChar(128)
  expiresAt      DateTime
  createdAt      DateTime                   @default(now())

  @@index([expiresAt])
  @@index([vehicleId])
}

model refunds {
  id               String         @id
  paymentId        String
  amount           Decimal        @db.Decimal(10, 2)
  reason           String?        @db.VarChar(255)
  status           refunds_status @default(PENDING)
  providerRefundId String?        @unique @db.VarChar(128)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  payments         payments       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

model report_documents {
  id                 String                      @id
  bookingId          String
  inspectionId       String?
  comparisonId       String?
  reportType         report_documents_reportType
  version            Int                         @default(1)
  title              String                      @db.VarChar(255)
  pdfUrl             String                      @db.VarChar(512)
  fileSizeBytes      Int                         @default(0)
  sha256Hash         String                      @db.VarChar(64)
  metadata           String?                     @db.Text
  generatedAt        DateTime                    @default(now())
  bookings           Booking                     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  damage_comparisons damage_comparisons?         @relation(fields: [comparisonId], references: [id])
  inspections        Inspection?                 @relation(fields: [inspectionId], references: [id])

  @@index([bookingId])
  @@index([comparisonId])
  @@index([inspectionId])
  @@index([reportType])
}

