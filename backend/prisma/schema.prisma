model CustomerDocument {
  id                 String    @id @default(cuid())
  customerId         String
  documentType       String    @db.VarChar(64)
  title              String    @db.VarChar(128)
  documentNumber     String?   @db.VarChar(128)
  fileUrl            String    @db.VarChar(512)
  fileName           String?   @db.VarChar(255)
  fileSize           Int?
  verificationStatus String    @default("PENDING_VERIFICATION") @db.VarChar(32)
  rejectionReason    String?   @db.VarChar(255)
  issuedAt           DateTime?
  expiresAt          DateTime?
  verifiedAt         DateTime?
  verifiedBy         String?   @db.VarChar(128)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([documentType])
  @@index([verificationStatus])
  @@map("customer_documents")
}

model CustomerNotification {
  id         String    @id @default(cuid())
  customerId String
  category   String    @db.VarChar(32)
  title      String    @db.VarChar(128)
  message    String    @db.Text
  actionUrl  String?   @db.VarChar(255)
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([isRead])
  @@index([createdAt])
  @@map("customer_notifications")
}

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique @db.VarChar(64)
  customerId   String
  bookingId    String?
  subject      String          @db.VarChar(255)
  category     String          @default("GENERAL") @db.VarChar(48)
  priority     String          @default("NORMAL") @db.VarChar(24)
  status       String          @default("OPEN") @db.VarChar(24)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages     TicketMessage[]

  @@index([customerId])
  @@index([status])
  @@index([ticketNumber])
  @@map("support_tickets")
}

model TicketMessage {
  id            String        @id @default(cuid())
  ticketId      String
  senderType    String        @db.VarChar(24)
  senderName    String        @db.VarChar(128)
  message       String        @db.Text
  attachmentUrl String?       @db.VarChar(512)
  createdAt     DateTime      @default(now())
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

model VehicleReview {
  id         String   @id @default(cuid())
  vehicleId  String
  customerId String
  bookingId  String   @unique
  rating     Int      @default(5)
  comment    String?  @db.Text
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([customerId])
  @@map("vehicle_reviews")
}
