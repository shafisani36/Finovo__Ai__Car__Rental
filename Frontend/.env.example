# Backend API base URL
VITE_API_URL=http://localhost:5000/api/v1

# Production domain used for SEO canonical URLs (no trailing slash)
VITE_SITE_URL=https://www.example.com

# Stripe publishable key (sandbox: pk_test_...). Optional: if empty, the key is read from the backend.
VITE_STRIPE_PUBLISHABLE_KEY=

# Error monitoring (optional). Sentry project DSN for the browser (platform: React). Leave empty to turn off.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
